{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5210",
  "Equipment": {
    "Simulate": true,
    "SimulateFailing": [
      "*"
    ]
  },
  "Network": {
    "CheckUrl": "https://api.open-meteo.com/",
    "SimulateOffline": false
  },
  "Setup": {
    "SimulateMissing": true
  },
  "Nina": {
    "BaseUrl": "http://localhost:1888/v2/api/",
    "ExePath": "",
    "LaunchIfNotRunning": true,
    "StartupTimeoutSeconds": 90
  },
  "Assistant": {
    "Provider": "gemini",
    "Models": [
      "gemini-flash-latest",
      "gemini-flash-lite-latest",
      "gemini-3.5-flash"
    ],
    "Effort": "low"
  },
  "Sky": {
    "NinaDatabase": ""
  }
}
