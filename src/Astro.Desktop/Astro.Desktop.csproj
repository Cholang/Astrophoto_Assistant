<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Astro.Server\Astro.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 실행 파일 이름 = product.json의 id (Directory.Build.props — name은 한글일 수 있어 영문 id로) -->
    <AssemblyName>$(AppProductId)</AssemblyName>
    <!-- 앱 아이콘: 실행 파일·작업 표시줄·Alt+Tab·창 제목 (원본 그림: 저장소 맨 위 AstrophotoAssistant.png, 16~256px를 담은 .ico) -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- 코어 서버를 같은 프로세스에서 실행한다. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
